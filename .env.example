# Frontend build-time variable (Vercel / local .env):
# Supports both VITE_API_URL and VITE_API_BASE_URL.
# If omitted in production, defaults to https://quickdownload-api.onrender.com
VITE_API_URL=https://quickdownload-api.onrender.com
VITE_API_BASE_URL=https://quickdownload-api.onrender.com

# Backend runtime variables (Render):
# FRONTEND_ORIGIN / FRONTEND_ORIGINS: Comma-separated allowed frontend origins for CORS.
# Defaults allow all *.vercel.app and localhost origins.
FRONTEND_ORIGIN=https://quick-d.vercel.app
FRONTEND_ORIGINS=https://quick-d.vercel.app,https://quickdownload-sashibitcode.vercel.app

# PUBLIC_API_URL: Canonical public HTTPS URL of the backend (e.g. for generating download links)
PUBLIC_API_URL=https://quickdownload-api.onrender.com

# Optional proxy URL (e.g. Webshare residential / rotating proxy) to bypass datacenter IP blocks
# YOUTUBE_PROXY=http://username:password@proxy-ip:port
