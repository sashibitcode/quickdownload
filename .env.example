# ==============================================================================
# Frontend Environment Variables (Set in Vercel Dashboard or local .env)
# ==============================================================================
# Production backend API URL. Supports VITE_API_URL or VITE_API_BASE_URL.
# If omitted on Vercel, defaults to same-origin /api (via vercel.json rewrite proxy)
# with automatic fallback to https://quickdownload-api.onrender.com
VITE_API_URL=https://quickdownload-api.onrender.com
VITE_API_BASE_URL=https://quickdownload-api.onrender.com

# ==============================================================================
# Backend Runtime Variables (Set in Render Dashboard / Railway / Docker)
# ==============================================================================
# Port for the FastAPI server (Render sets PORT=10000 automatically)
PORT=8000

# Allowed Frontend Origins for CORS (comma-separated):
# Supports ALLOWED_ORIGINS, FRONTEND_ORIGINS, and FRONTEND_ORIGIN.
# Defaults automatically permit localhost, 127.0.0.1, LAN IPs, and *.vercel.app.
ALLOWED_ORIGINS=https://quick-d.vercel.app,https://quickdownload-sashibitcode.vercel.app
FRONTEND_ORIGIN=https://quick-d.vercel.app
FRONTEND_ORIGINS=https://quick-d.vercel.app,https://quickdownload-sashibitcode.vercel.app

# Canonical public HTTPS URL of backend (for generating downloadable media links)
PUBLIC_API_URL=https://quickdownload-api.onrender.com

# Debug endpoint protection token for GET /debug/yt
# If unset, the debug endpoint is accessible without token for diagnostics.
# DEBUG_TOKEN=quickdownload_debug_secret_key

# Optional Residential / Rotating Proxy (e.g. Webshare) to bypass datacenter IP blocks
# Supports host:port:user:pass or http://user:pass@host:port
# YT_PROXY=http://username:password@proxy-ip:port
# YOUTUBE_PROXY=http://username:password@proxy-ip:port
# INSTAGRAM_PROXY=http://username:password@proxy-ip:port

# Optional Cookies for Bot Protection / Restricted Content Bypass:
# Option A: Direct file path (e.g. Render Secret File mounted at /etc/secrets/cookies.txt)
# YOUTUBE_COOKIES_FILE=/etc/secrets/youtube_cookies.txt
# INSTAGRAM_COOKIES_FILE=/etc/secrets/instagram_cookies.txt
# Option B: Base64-encoded Netscape format cookie string or raw text
# YT_COOKIES=
# YOUTUBE_COOKIES_B64=
# INSTAGRAM_COOKIES_B64=

# Optional YouTube Proof of Origin (PO) Token
# YT_PO_TOKEN=
# YT_VISITOR_DATA=
