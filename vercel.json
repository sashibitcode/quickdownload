{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/download-file",
      "destination": "https://quickdownload-api.onrender.com/download-file"
    },
    {
      "source": "/api/:path*",
      "destination": "https://quickdownload-api.onrender.com/api/:path*"
    }
  ]
}
